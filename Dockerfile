# 1. Базовый образ: используем легкий и стабильный образ Python 3.10
FROM python:3.11-slim

# 2. Рабочая директория внутри контейнера (все пути будут отсчитываться от нее)
WORKDIR /app

# 3. Переменная окружения: отключает буферизацию вывода Python, 
# чтобы логи в консоли Docker появлялись мгновенно, а не копились в памяти
ENV PYTHONUNBUFFERED=1

# 4. Копируем файл зависимостей первым. 
# Docker кэширует слои: если requirements.txt не менялся, установка не будет повторяться
COPY requirements.txt .

# 5. Устанавливаем зависимости. Флаг --no-cache-dir уменьшает размер образа
RUN pip install --no-cache-dir --upgrade -r requirements.txt

# 6. Копируем исходный код проекта в контейнер
COPY src/ ./src/

# 7. Открываем порт 8000, на котором по умолчанию работает FastAPI (uvicorn)
EXPOSE 8000

# 8. Команда запуска приложения. 
CMD ["uvicorn", "src.app:app", "--host", "0.0.0.0", "--port", "8000"]